{
  // Typechecks the TESTS, which the build config cannot: it sets `rootDir:
  // src` so it can emit, and a test file outside that root is an error there.
  //
  // Without this, `implements Dispatcher` in a test stub was never checked
  // against the interface — a stub missing the required `stream()` compiled
  // fine for as long as nothing called it. Two changes have now been caught
  // only at runtime for want of this file: a stub that would have crashed the
  // moment the router stopped preferring `dispatch()`, and an import left
  // pointing at a module that no longer re-exported the symbol.
  //
  // noEmit, so this is purely a check; vitest transpiles the tests itself.
  //
  // Part of `npm run check`. It started at 125 errors; clearing them turned up
  // a real one — `RetryOutcome` did not declare `droppedModel`, a field
  // `retryJob` sets and the MCP tool documents — and five fixtures scoring a
  // `surface: "vendor_cli"` that is in no union and no config.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // A test may legitimately leave an argument unused when it is pinning a
    // callback's shape; the src rule stays strict.
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "tests/**/*"],
  // The base excludes `tests`; that has to be overridden, not just added to.
  "exclude": ["node_modules", "dist"]
}
