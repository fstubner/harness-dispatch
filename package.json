{
  "name": "harness-dispatch",
  "version": "0.12.0",
  "description": "Turn locally installed coding harnesses (Claude Code, Codex, Cursor, Antigravity) and local/remote API endpoints into tools any AI can call, with async job handling for long-running agent work.",
  "keywords": [
    "mcp",
    "claude",
    "coding",
    "ai-agents",
    "llm",
    "cursor",
    "codex",
    "dispatch",
    "antigravity"
  ],
  "license": "MIT",
  "author": "Felix Stubner",
  "homepage": "https://github.com/fstubner/harness-dispatch#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "harness-dispatch": "dist/bin.js"
  },
  "files": [
    "dist/",
    "config.default.yaml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run typecheck:tests && npm run lint && npm test && node scripts/check-claims.mjs",
    "dev": "tsx src/bin.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/scoring-parity.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "test:unit": "vitest run",
    "check:claims": "npm run build && node scripts/check-claims.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "cross-spawn": "^7.0.6",
    "js-yaml": "^4.3.1",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-fs": "^0.40.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    },
    "@opentelemetry/instrumentation": {
      "optional": true
    },
    "@opentelemetry/instrumentation-fs": {
      "optional": true
    },
    "@opentelemetry/instrumentation-http": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-fs": "^0.40.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.4",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.11.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fstubner/harness-dispatch.git"
  },
  "bugs": {
    "url": "https://github.com/fstubner/harness-dispatch/issues"
  }
}
