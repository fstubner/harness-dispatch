{
  "name": "harness-dispatch",
  "version": "0.6.5",
  "description": "Turn locally installed coding harnesses (Claude Code, Codex, Cursor, Antigravity) and local/remote API endpoints into tools any AI can call, with async job handling for long-running agent work.",
  "keywords": [
    "mcp",
    "claude",
    "coding",
    "ai-agents",
    "llm",
    "cursor",
    "codex",
    "dispatch",
    "antigravity"
  ],
  "license": "MIT",
  "author": "Felix Stubner",
  "homepage": "https://fstubner.github.io/harness-dispatch/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "harness-dispatch": "dist/bin.js"
  },
  "files": [
    "dist/",
    "data/",
    "config.default.yaml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "tsx src/bin.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/scoring-parity.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-fs": "^0.40.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "cross-spawn": "^7.0.6",
    "js-yaml": "^4.3.1",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "body-parser": "^2.3.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fstubner/harness-dispatch.git"
  },
  "bugs": {
    "url": "https://github.com/fstubner/harness-dispatch/issues"
  }
}
